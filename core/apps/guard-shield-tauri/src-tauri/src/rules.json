    "category": "protocol_anomaly",
    "severity": "low",
    "impact_score": 2.5,
    "protocol": "IP",
    "src_ip": "any",
    "dst_ip": "any",
    "src_port": "any",
    "dst_port": "any",
    "conditions": {
      "ttl": "<=2"
    },
