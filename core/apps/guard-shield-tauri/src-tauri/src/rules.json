[
  {
    "sid": 1000001,
    "msg": "SCAN TCP SYN Port Scan",
    "category": "reconnaissance",
    "severity": "medium",
    "impact_score": 5.0,
    "protocol": "TCP",
    "src_ip": "any",
    "dst_ip": "any",
    "src_port": "any",
    "dst_port": "any",
    "conditions": {
      "tcp_flags": ["SYN"],
      "packet_count_threshold": 50,
      "time_window_secs": 2
    },
    "description": "Detects high-frequency TCP connection attempts with SYN flag set from a single source, characteristic of scanning tools like Nmap.",
    "reference": "MITRE ATT&CK T1046"
  },
  {
    "sid": 1000002,
    "msg": "SCAN TCP FIN Stealth Scan",
    "category": "reconnaissance",
    "severity": "medium",
    "impact_score": 5.5,
    "protocol": "TCP",
    "src_ip": "any",
    "dst_ip": "any",
    "src_port": "any",
    "dst_port": "any",
    "conditions": {
      "tcp_flags": ["FIN"]
    },
    "description": "Detects TCP packet with only the FIN flag set. FIN-only packets without established connections are commonly used to bypass firewalls and determine active ports.",
    "reference": "MITRE ATT&CK T1046"
  },
  {
    "sid": 1000003,
    "msg": "SCAN TCP Xmas Tree Scan",
    "category": "reconnaissance",
    "severity": "high",
    "impact_score": 6.5,
    "protocol": "TCP",
    "src_ip": "any",
    "dst_ip": "any",
