  },
  {
    "sid": 1000053,
    "msg": "ANOMALY Invalid TCP Flags Combo (SYN/FIN)",
    "category": "protocol_anomaly",
    "severity": "high",
    "impact_score": 7.0,
    "protocol": "TCP",
    "src_ip": "any",
    "dst_ip": "any",
    "src_port": "any",
    "dst_port": "any",
